# TraceVault Environment Configuration
# Copy this file to .env and customize for your environment.
# NEVER commit .env with real values to version control.

# =============================================================================
# DATA STORAGE
# =============================================================================
# Local directory for documents, indexes, and runtime data
# TRACEVAULT_DATA_DIR=./data

# =============================================================================
# LOGGING
# =============================================================================
# Valid values: DEBUG, INFO, WARNING, ERROR
# TRACEVAULT_LOG_LEVEL=INFO

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================
# Provider options: local, ollama, openai
# TRACEVAULT_MODEL_PROVIDER=local

# Model names (optional, provider-specific defaults used if not set)
# TRACEVAULT_EMBEDDING_MODEL=
# TRACEVAULT_REASONING_MODEL=

# =============================================================================
# CHUNKING
# =============================================================================
# Maximum characters per chunk (default: 1000)
# TRACEVAULT_CHUNK_SIZE=1000

# Overlap between chunks in characters (default: 200)
# TRACEVAULT_CHUNK_OVERLAP=200

# =============================================================================
# RETRIEVAL
# =============================================================================
# Number of results to retrieve (default: 5)
# TRACEVAULT_TOP_K=5

# Hybrid retrieval weight: 0.0 = BM25 only, 1.0 = vector only, 0.5 = balanced
# TRACEVAULT_HYBRID_ALPHA=0.5

# =============================================================================
# VALIDATION
# =============================================================================
# Minimum confidence threshold for answers (0.0 to 1.0)
# TRACEVAULT_MIN_CONFIDENCE=0.7

# Maximum allowed unsupported claims (0 = strict, >0 = lenient)
# TRACEVAULT_MAX_UNSUPPORTED_CLAIMS=0
