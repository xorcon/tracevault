# Example environment file only.
# Copy this file to .env for local development.
# Do not commit real secrets, tokens, API keys, or production database URLs.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hermes_agent

# Model Runtime
MODEL_PROVIDER=ollama
REFINEMENT_MODEL=gemma4:e4b
REASONING_MODEL=qwopus:27b
EMBEDDING_MODEL=nomic-embed-text

# Retrieval
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
FINAL_TOP_K=8
